# ==============================================================================
# NAWI Testing & Calibration Management System — Environment Configuration
# ==============================================================================

# Project Identification
PROJECT_NAME="NAWI Testing & Calibration Management System"
TEAM_NAME="VisionVerity"
PROBLEM_STATEMENT_ID="SIH26035"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# LOCAL (SQLite):
DATABASE_URL="sqlite:///./nawi_calibration.db"

# PRODUCTION (Render / Neon / Supabase PostgreSQL):
# Note: Both postgres:// and postgresql:// URL schemes are automatically normalized.
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# In production, set to your specific frontend URL(s) or '[]' (Vercel domains matched automatically).
# Accepts JSON array (e.g. '[]' or '["https://your-nawi-app.vercel.app"]') or comma-separated string.
# Wildcard '*' is not used in production.
CORS_ORIGINS=[]

# ------------------------------------------------------------------------------
# PDF Report Storage Directory
# ------------------------------------------------------------------------------
# Local development:
REPORTS_DIR="./reports/generated"

# Cloud (Render ephemeral disk / mounted disk):
# REPORTS_DIR="/tmp/nawi_reports"
